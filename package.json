{
  "name": "finanzapp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Personal Finance Platform (Web, Mobile & API)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "npm run dev --workspace=@finanzapp/api",
    "dev:web": "npm run dev --workspace=@finanzapp/web",
    "dev:mobile": "npm run start --workspace=@finanzapp/mobile",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=@finanzapp/api",
    "db:seed": "npm run prisma:seed --workspace=@finanzapp/api",
    "db:studio": "npm run prisma:studio --workspace=@finanzapp/api"
  },
  "dependencies": {
    "next": "14.2.24",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "npm@10.8.1"
}
